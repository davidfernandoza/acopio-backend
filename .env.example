PORT=3000
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=acopio
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=smtp-relay.sendinblue.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Debe ser un remitente YA verificado en Brevo → Senders, Domains & Dedicated IPs
SMTP_FROM="Acopio <noreply@tudominio.com>"
SUPPORT_EMAIL=soporte@acopio.com
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=acopio
R2_PREFIX=images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# URL pública del bucket (r2.dev o dominio custom). Si está vacía, el backend firma las URLs.
R2_PUBLIC_URL=
