<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Contacto Acopio</title>
</head>
<body style="margin:0;padding:0;background-color:#eef3f1;font-family:Segoe UI,Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#eef3f1;padding:32px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;width:100%;background-color:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 8px 24px rgba(31,111,91,0.08);">
          <tr>
            <td style="background-color:#1f6f5b;padding:28px 32px;text-align:center;">
              <img src="cid:acopio-logo" width="56" height="56" alt="Acopio" style="display:block;margin:0 auto 12px auto;border:0;border-radius:12px;" />
              <p style="margin:0;font-size:22px;font-weight:700;color:#ffffff;letter-spacing:0.02em;">Acopio</p>
            </td>
          </tr>
          <tr>
            <td style="padding:36px 32px 16px 32px;">
              <p style="margin:0 0 8px 0;font-size:12px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#1f6f5b;">
                Formulario de contacto
              </p>
              <h1 style="margin:0 0 24px 0;font-size:22px;line-height:1.35;font-weight:700;color:#16352d;">
                Nuevo mensaje de {{name}}
              </h1>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4faf7;border:1px solid #d5e8e0;border-radius:12px;">
                <tr>
                  <td style="padding:20px 22px;">
                    <p style="margin:0 0 10px 0;font-size:14px;line-height:1.5;color:#3d4f48;">
                      <span style="display:inline-block;min-width:80px;color:#5a6b65;">Nombre</span>
                      <strong style="color:#16352d;">{{name}}</strong>
                    </p>
                    <p style="margin:0;font-size:14px;line-height:1.5;color:#3d4f48;">
                      <span style="display:inline-block;min-width:80px;color:#5a6b65;">Correo</span>
                      <a href="mailto:{{email}}" style="color:#1f6f5b;font-weight:700;text-decoration:none;">{{email}}</a>
                    </p>
                  </td>
                </tr>
              </table>

              <p style="margin:28px 0 10px 0;font-size:12px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#1f6f5b;">
                Mensaje
              </p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #e3ece8;border-radius:12px;">
                <tr>
                  <td style="padding:18px 20px;font-size:15px;line-height:1.65;color:#3d4f48;white-space:pre-wrap;">{{message}}</td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:20px 32px 28px 32px;">
              <p style="margin:0;font-size:13px;line-height:1.5;color:#7a8a84;">
                Puedes responder este correo directamente; la respuesta llegará a
                <a href="mailto:{{email}}" style="color:#1f6f5b;text-decoration:underline;">{{email}}</a>.
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding:20px 32px;background-color:#f7faf9;border-top:1px solid #e3ece8;">
              <p style="margin:0;font-size:12px;line-height:1.5;color:#7a8a84;text-align:center;">
                Notificación automática de <strong style="color:#1f6f5b;">Acopio</strong>.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
