<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Invitación a gestionar el acopio</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
</head>
<body style="margin:0;padding:0;background-color:#eef3f1;font-family:Segoe UI,Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#eef3f1;padding:32px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;width:100%;background-color:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 8px 24px rgba(31,111,91,0.08);">
          <tr>
            <td style="background-color:#1f6f5b;padding:28px 32px;text-align:center;">
              <img src="cid:acopio-logo" width="56" height="56" alt="Acopio" style="display:block;margin:0 auto 12px auto;border:0;border-radius:12px;" />
              <p style="margin:0;font-size:22px;font-weight:700;color:#ffffff;letter-spacing:0.02em;">Acopio</p>
            </td>
          </tr>
          <tr>
            <td style="padding:36px 32px 16px 32px;">
              <p style="margin:0 0 8px 0;font-size:15px;line-height:1.5;color:#5a6b65;">Hola {{managerName}},</p>
              <h1 style="margin:0 0 16px 0;font-size:22px;line-height:1.35;font-weight:700;color:#16352d;">
                Te invitaron a gestionar un acopio
              </h1>
              <p style="margin:0 0 24px 0;font-size:15px;line-height:1.6;color:#3d4f48;">
                Ahora puedes administrar
                <strong style="color:#1f6f5b;">&ldquo;{{acopioName}}&rdquo;</strong>
                desde la plataforma Acopio.
              </p>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4faf7;border:1px solid #d5e8e0;border-radius:12px;">
                <tr>
                  <td style="padding:20px 22px;">
                    <p style="margin:0 0 12px 0;font-size:12px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#1f6f5b;">
                      Datos de acceso
                    </p>
                    <p style="margin:0 0 8px 0;font-size:14px;line-height:1.5;color:#3d4f48;">
                      <span style="display:inline-block;min-width:140px;color:#5a6b65;">Correo</span>
                      <strong style="color:#16352d;">{{toEmail}}</strong>
                    </p>
                    {{#if temporaryPassword}}
                    <p style="margin:0;font-size:14px;line-height:1.5;color:#3d4f48;">
                      <span style="display:inline-block;min-width:140px;color:#5a6b65;">Contraseña temporal</span>
                      <strong style="font-family:Consolas,Monaco,monospace;font-size:15px;color:#16352d;letter-spacing:0.04em;">{{temporaryPassword}}</strong>
                    </p>
                    {{else}}
                    <p style="margin:0;font-size:14px;line-height:1.55;color:#3d4f48;">
                      Usa la contraseña que ya tienes, o inicia sesión con Google si ese correo está vinculado.
                    </p>
                    {{/if}}
                  </td>
                </tr>
              </table>

              {{#if temporaryPassword}}
              <p style="margin:16px 0 0 0;font-size:13px;line-height:1.5;color:#8a5a3b;">
                Te recomendamos cambiar la contraseña temporal después de iniciar sesión.
              </p>
              {{/if}}
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:8px 32px 36px 32px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" bgcolor="#1f6f5b" style="border-radius:10px;">
                    <a href="{{loginUrl}}" target="_blank" style="display:inline-block;padding:14px 28px;font-size:15px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:10px;background-color:#1f6f5b;">
                      Iniciar sesión
                    </a>
                  </td>
                </tr>
              </table>
              <p style="margin:18px 0 0 0;font-size:12px;line-height:1.5;color:#7a8a84;word-break:break-all;">
                Si el botón no funciona, copia este enlace:<br />
                <a href="{{loginUrl}}" style="color:#1f6f5b;text-decoration:underline;">{{loginUrl}}</a>
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding:20px 32px;background-color:#f7faf9;border-top:1px solid #e3ece8;">
              <p style="margin:0;font-size:12px;line-height:1.5;color:#7a8a84;text-align:center;">
                Este mensaje fue enviado por <strong style="color:#1f6f5b;">Acopio</strong>.
                Si no esperabas esta invitación, puedes ignorar este correo.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
